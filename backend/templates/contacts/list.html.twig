{% extends 'base.html.twig' %}

{% block title %}Contacts - DropCrypt{% endblock %}

{% block body %}
<style>
    /* Transparent gradient overlay */
    .contacts-gradient-overlay {
        background: linear-gradient(135deg, 
            rgba(17, 24, 39, 0.5) 0%,    /* gray-900 with 50% opacity */
            rgba(30, 58, 138, 0.4) 50%,  /* blue-900 with 40% opacity */
            rgba(88, 28, 135, 0.3) 100%  /* purple-900 with 30% opacity */
        );
    }
    
    /* Glass card with better contrast */
    .glass-card {
        background: rgba(30, 30, 30, 0.7);
        border: 1px solid rgba(37, 99, 235, 0.3);
        border-radius: 12px;
        box-shadow: 
            0 4px 6px -1px rgba(0, 0, 0, 0.3),
            0 2px 4px -1px rgba(0, 0, 0, 0.2),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }
</style>
<div class="h-full flex flex-col contacts-gradient-overlay">
    <div class="flex-1 overflow-y-auto">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <h1 class="text-3xl font-bold text-white mb-6">Contacts</h1>
            <div class="glass-card p-6">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-white">Your Contacts</h2>
                <button id="btn-add-contact" class="btn-security px-6 py-2">
                    <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Contact
                </button>
            </div>

            <div id="contacts-list" class="space-y-3">
                <!-- Contacts will be loaded here -->
            </div>

            <div id="contacts-loader" class="text-center py-8">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-400"></div>
                <p class="text-gray-400 mt-2 text-sm">Loading contacts...</p>
            </div>

            <div id="no-contacts" class="hidden text-center py-12 text-gray-400">
                <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <p class="text-lg">No contacts yet</p>
                <p class="text-sm mt-1">Add contacts to give them friendly nicknames</p>
            </div>
        </div>
    </div>
</div>

<!-- Add Contact Modal -->
<div id="add-contact-modal" class="hidden fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 px-4">
    <div class="glass-card p-8 max-w-md w-full">
        <h3 class="text-2xl font-bold text-white mb-6">Add Contact</h3>
        
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Anonymous ID</label>
                <input 
                    type="text" 
                    id="contact-id" 
                    class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white"
                    placeholder="usr_xxxxxxxxxxxxxxxx"
                >
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Nickname (Optional)</label>
                <input 
                    type="text" 
                    id="contact-nickname" 
                    class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white"
                    placeholder="Friend, Colleague, etc."
                >
            </div>

            <div id="add-error" class="hidden alert-error text-sm"></div>

            <div class="flex space-x-3">
                <button id="btn-save-contact" class="flex-1 btn-security py-3">Add</button>
                <button id="btn-cancel-add" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-lg">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Contact Modal -->
<div id="edit-contact-modal" class="hidden fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 px-4">
    <div class="glass-card p-8 max-w-md w-full">
        <h3 class="text-2xl font-bold text-white mb-6">Edit Contact</h3>
        
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Nickname</label>
                <input 
                    type="text" 
                    id="edit-nickname" 
                    class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white"
                >
            </div>

            <div id="edit-error" class="hidden alert-error text-sm"></div>

            <div class="flex space-x-3">
                <button id="btn-save-edit" class="flex-1 btn-security py-3">Save</button>
                <button id="btn-cancel-edit" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-lg">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
(async function() {
    const sessionToken = localStorage.getItem('dropcrypt_session');

    if (!sessionToken) {
        window.location.href = '/account/login';
        return;
    }

    let contacts = [];
    let editingContactId = null;

    // Load contacts
    async function loadContacts() {
        try {
            const response = await fetch('/api/contacts', {
                headers: { 'Authorization': 'Bearer ' + sessionToken }
            });

            if (!response.ok) throw new Error('Failed to load contacts');

            const data = await response.json();
            contacts = data.contacts;

            const contactsList = document.getElementById('contacts-list');
            const contactsLoader = document.getElementById('contacts-loader');
            const noContacts = document.getElementById('no-contacts');

            contactsLoader.classList.add('hidden');

            if (contacts.length === 0) {
                noContacts.classList.remove('hidden');
                return;
            }

            noContacts.classList.add('hidden');
            contactsList.innerHTML = contacts.map(contact => `
                <div class="bg-gray-800 bg-opacity-50 rounded-lg p-4 flex items-center justify-between">
                    <div class="flex-1">
                        <h3 class="text-white font-semibold">${contact.nickname || 'No nickname'}</h3>
                        <p class="text-gray-400 text-sm font-mono">${contact.userId}</p>
                        <p class="text-gray-500 text-xs mt-1">Added ${new Date(contact.addedAt).toLocaleDateString()}</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <a href="/chat/thread/${contact.userId}" class="text-blue-400 hover:text-blue-300 p-2" title="Message">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                        </a>
                        <button class="text-gray-400 hover:text-white p-2 edit-btn" data-id="${contact.id}" title="Edit">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </button>
                        <button class="text-red-400 hover:text-red-300 p-2 delete-btn" data-id="${contact.id}" title="Delete">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                    </div>
                </div>
            `).join('');

            // Attach event listeners
            document.querySelectorAll('.edit-btn').forEach(btn => {
                btn.addEventListener('click', () => editContact(parseInt(btn.dataset.id)));
            });

            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', () => deleteContact(parseInt(btn.dataset.id)));
            });
        } catch (error) {
            console.error('Failed to load contacts:', error);
        }
    }

    // Add contact modal
    const addModal = document.getElementById('add-contact-modal');
    document.getElementById('btn-add-contact').addEventListener('click', () => {
        addModal.classList.remove('hidden');
    });

    document.getElementById('btn-cancel-add').addEventListener('click', () => {
        addModal.classList.add('hidden');
    });

    document.getElementById('btn-save-contact').addEventListener('click', async () => {
        const userId = document.getElementById('contact-id').value.trim();
        const nickname = document.getElementById('contact-nickname').value.trim();
        const errorDiv = document.getElementById('add-error');

        errorDiv.classList.add('hidden');

        if (!userId) {
            errorDiv.textContent = 'Please enter an Anonymous ID';
            errorDiv.classList.remove('hidden');
            return;
        }

        try {
            const response = await fetch('/api/contacts', {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + sessionToken,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ userId, nickname })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || 'Failed to add contact');
            }

            addModal.classList.add('hidden');
            document.getElementById('contact-id').value = '';
            document.getElementById('contact-nickname').value = '';
            loadContacts();
        } catch (error) {
            errorDiv.textContent = error.message;
            errorDiv.classList.remove('hidden');
        }
    });

    // Edit contact
    const editModal = document.getElementById('edit-contact-modal');
    
    function editContact(contactId) {
        const contact = contacts.find(c => c.id === contactId);
        if (!contact) return;

        editingContactId = contactId;
        document.getElementById('edit-nickname').value = contact.nickname || '';
        editModal.classList.remove('hidden');
    }

    document.getElementById('btn-cancel-edit').addEventListener('click', () => {
        editModal.classList.add('hidden');
    });

    document.getElementById('btn-save-edit').addEventListener('click', async () => {
        const nickname = document.getElementById('edit-nickname').value.trim();
        const errorDiv = document.getElementById('edit-error');

        errorDiv.classList.add('hidden');

        try {
            const response = await fetch(`/api/contacts/${editingContactId}`, {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + sessionToken,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ nickname })
            });

            if (!response.ok) throw new Error('Failed to update contact');

            editModal.classList.add('hidden');
            loadContacts();
        } catch (error) {
            errorDiv.textContent = error.message;
            errorDiv.classList.remove('hidden');
        }
    });

    // Delete contact
    async function deleteContact(contactId) {
        if (!confirm('Are you sure you want to remove this contact?')) return;

        try {
            const response = await fetch(`/api/contacts/${contactId}`, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + sessionToken }
            });

            if (!response.ok) throw new Error('Failed to delete contact');

            loadContacts();
        } catch (error) {
            alert('Failed to delete contact: ' + error.message);
        }
    }

    // Initialize
    loadContacts();
})();
</script>
{% endblock %}

