{% extends 'base.html.twig' %}

{% block title %}Create Anonymous Account - DropCrypt{% endblock %}

{% block body %}
<style>
    /* Transparent gradient overlay for account creation page */
    .create-gradient-overlay {
        background: linear-gradient(135deg, 
            rgba(17, 24, 39, 0.5) 0%,    /* gray-900 with 50% opacity */
            rgba(30, 58, 138, 0.4) 50%,  /* blue-900 with 40% opacity */
            rgba(88, 28, 135, 0.3) 100%  /* purple-900 with 30% opacity */
        );
    }
    
    /* Glass card with better contrast */
    .glass-card {
        background: rgba(30, 30, 30, 0.7);
        border: 1px solid rgba(37, 99, 235, 0.3);
        border-radius: 12px;
        box-shadow: 
            0 4px 6px -1px rgba(0, 0, 0, 0.3),
            0 2px 4px -1px rgba(0, 0, 0, 0.2),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }
</style>
<div class="h-full create-gradient-overlay flex items-center justify-center px-4">
    <div class="max-w-2xl w-full">
        <div class="glass-card p-8">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-white mb-2">Create Anonymous Account</h1>
                <p class="text-gray-300">Generate your secure, anonymous messaging credentials</p>
            </div>

            <div id="step-generate" class="step-content">
                <div class="alert-info mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span><strong>Zero-Knowledge Security:</strong> Your credentials are generated locally. We never see your password or private keys.</span>
                </div>

                <div class="text-center">
                    <button id="btn-generate" class="btn-security inline-flex items-center px-8 py-4 text-lg font-semibold">
                        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                        </svg>
                        Generate Account
                    </button>
                </div>

                <div id="generation-loader" class="hidden text-center py-8">
                    <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-400"></div>
                    <p class="text-white mt-4">Generating secure credentials...</p>
                </div>
            </div>

            <div id="step-credentials" class="step-content hidden">
                <div class="alert-warning mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span><strong>IMPORTANT:</strong> Save these credentials immediately. You cannot recover them if lost!</span>
                </div>

                <div class="space-y-4 mb-6">
                    <div class="credential-box">
                        <label class="block text-sm font-medium text-gray-300 mb-2">Anonymous ID</label>
                        <div class="flex items-center gap-2">
                            <code id="anonymous-id" class="flex-1 bg-gray-800 text-blue-300 px-4 py-3 rounded-lg font-mono text-sm"></code>
                            <button class="copy-btn" data-copy="anonymous-id">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="credential-box">
                        <label class="block text-sm font-medium text-gray-300 mb-2">Auto-Generated Password</label>
                        <div class="flex items-center gap-2">
                            <code id="password" class="flex-1 bg-gray-800 text-green-300 px-4 py-3 rounded-lg font-mono text-sm"></code>
                            <button class="copy-btn" data-copy="password">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </button>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">You can change this later in settings</p>
                    </div>

                    <div class="credential-box">
                        <label class="block text-sm font-medium text-gray-300 mb-2">24-Word Recovery Phrase</label>
                        <div class="flex items-center gap-2">
                            <code id="recovery-phrase" class="flex-1 bg-gray-800 text-purple-300 px-4 py-3 rounded-lg font-mono text-xs leading-relaxed"></code>
                            <button class="copy-btn" data-copy="recovery-phrase">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </button>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Required for account recovery</p>
                    </div>
                </div>

                <div class="mb-6">
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="checkbox" id="confirm-saved" class="w-5 h-5 text-blue-600 rounded focus:ring-2 focus:ring-blue-500">
                        <span class="text-white">I have securely saved my credentials</span>
                    </label>
                </div>

                <button id="btn-finalize" class="w-full btn-security py-4 text-lg font-semibold disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    Complete Account Setup
                </button>

                <div id="finalize-loader" class="hidden text-center py-4">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-400"></div>
                    <p class="text-white mt-2">Finalizing account...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/crypto-helper.js?v=4"></script>
<script>
(async function() {
    const btnGenerate = document.getElementById('btn-generate');
    const btnFinalize = document.getElementById('btn-finalize');
    const confirmSaved = document.getElementById('confirm-saved');
    
    let accountData = null;
    let crypto = new CryptoHelper();

    // Step 1: Generate credentials
    btnGenerate.addEventListener('click', async () => {
        try {
            document.getElementById('generation-loader').classList.remove('hidden');
            btnGenerate.disabled = true;

            // Call backend to generate credentials
            const response = await fetch('/api/accounts/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            if (!response.ok) {
                throw new Error('Failed to generate account');
            }

            accountData = await response.json();

            // Display credentials
            document.getElementById('anonymous-id').textContent = accountData.anonymousId;
            document.getElementById('password').textContent = accountData.password;
            document.getElementById('recovery-phrase').textContent = accountData.recoveryPhrase;

            // Show credentials step
            document.getElementById('step-generate').classList.add('hidden');
            document.getElementById('step-credentials').classList.remove('hidden');

        } catch (error) {
            alert('Error: ' + error.message);
            document.getElementById('generation-loader').classList.add('hidden');
            btnGenerate.disabled = false;
        }
    });

    // Enable finalize button when checkbox is checked
    confirmSaved.addEventListener('change', () => {
        btnFinalize.disabled = !confirmSaved.checked;
    });

    // Step 2: Finalize account (generate keys client-side)
    btnFinalize.addEventListener('click', async () => {
        try {
            document.getElementById('finalize-loader').classList.remove('hidden');
            btnFinalize.disabled = true;

            // Generate RSA key pair client-side
            await crypto.generateKeyPair();
            const publicKey = await crypto.exportPublicKey();
            const privateKey = await crypto.exportPrivateKey();

            // Encrypt private key with password
            const encryptedPrivateKey = await crypto.encryptPrivateKey(privateKey, accountData.password);
            crypto.saveEncryptedPrivateKey(encryptedPrivateKey);

            // Send public key to server
            const response = await fetch('/api/accounts/finalize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    anonymousId: accountData.anonymousId,
                    publicKey: publicKey
                })
            });

            if (!response.ok) {
                throw new Error('Failed to finalize account');
            }

            const { sessionToken } = await response.json();

            // Save session
            localStorage.setItem('dropcrypt_session', sessionToken);
            localStorage.setItem('dropcrypt_anonymous_id', accountData.anonymousId);
            localStorage.setItem('dropcrypt_public_key', publicKey); // Save public key for encryption
            
            // Note: Password is NOT stored for security reasons
            // User will be prompted when accessing encrypted messages

            // Redirect to dashboard
            window.location.href = '/dashboard';

        } catch (error) {
            alert('Error: ' + error.message);
            document.getElementById('finalize-loader').classList.add('hidden');
            btnFinalize.disabled = false;
        }
    });

    // Copy button functionality
    document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-copy');
            const text = document.getElementById(targetId).textContent;
            navigator.clipboard.writeText(text);
            
            // Visual feedback
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
            setTimeout(() => {
                btn.innerHTML = originalHTML;
            }, 1000);
        });
    });
})();
</script>
{% endblock %}

