<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}DropCrypt - Secure Message Sharing{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.ico') }}">
        
        {# Modern CSS Framework #}
        <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
        
        {# Custom styles - Professional IT Security Theme #}
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
            
            * {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            }
            
            code, pre, .mono {
                font-family: 'JetBrains Mono', 'Courier New', monospace;
            }
            
            html, body {
                height: 100%;
                cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%23ffffff" stroke="%23000000" stroke-width="1"/><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%233b82f6" opacity="0.3"/></svg>') 3 3, auto;
            }
            
            a, button, .btn-security, input, textarea, select, [role="button"], [onclick] {
                cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%23ffffff" stroke="%23000000" stroke-width="1"/><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%2310b981" opacity="0.4"/></svg>') 3 3, pointer;
            }
            
            input[readonly], textarea[readonly] {
                cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%23ffffff" stroke="%23000000" stroke-width="1"/><path d="M3 3 L3 20 L10 13 L13 16 L20 3 Z" fill="%2360a5fa" opacity="0.3"/></svg>') 3 3, text;
            }
            
            body {
                background: #1a1a1a;
                background-image: 
                    radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.06) 0%, transparent 50%),
                    radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
                    radial-gradient(circle at 50% 20%, rgba(6, 182, 212, 0.03) 0%, transparent 50%);
                min-height: 100vh;
                color: #f1f5f9;
                position: relative;
                overflow-x: hidden;
                display: flex;
                flex-direction: column;
            }
            
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: 
                    repeating-linear-gradient(
                        0deg,
                        rgba(37, 99, 235, 0.015) 0px,
                        transparent 1px,
                        transparent 3px,
                        rgba(37, 99, 235, 0.015) 4px
                    );
                pointer-events: none;
                z-index: 1;
            }
            
            @keyframes subtleGlow {
                0%, 100% { box-shadow: 0 0 20px rgba(37, 99, 235, 0.3), 0 0 40px rgba(37, 99, 235, 0.1); }
                50% { box-shadow: 0 0 30px rgba(37, 99, 235, 0.5), 0 0 60px rgba(37, 99, 235, 0.2); }
            }
            
            @keyframes pulse {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.7; }
            }
            
            @keyframes shimmer {
                0% { background-position: -1000px 0; }
                100% { background-position: 1000px 0; }
            }
            
            /* Encryption background animation - Matrix style calculating */
            @keyframes calculateHash {
                0% {
                    opacity: 0;
                    transform: scale(0.8);
                    filter: blur(4px);
                }
                10% {
                    opacity: 0.3;
                    transform: scale(1);
                    filter: blur(2px);
                }
                20% {
                    opacity: 0.4;
                    filter: blur(1px);
                }
                30% {
                    opacity: 0.35;
                    filter: blur(0.5px);
                }
                40% {
                    opacity: 0.4;
                    filter: blur(0px);
                }
                50% {
                    opacity: 0.35;
                    filter: blur(0px);
                }
                60% {
                    opacity: 0.4;
                    filter: blur(0px);
                }
                70% {
                    opacity: 0.35;
                    filter: blur(0px);
                }
                80% {
                    opacity: 0.3;
                    filter: blur(1px);
                }
                90% {
                    opacity: 0.2;
                    transform: scale(1);
                    filter: blur(2px);
                }
                100% {
                    opacity: 0;
                    transform: scale(0.9);
                    filter: blur(4px);
                }
            }
            
            @keyframes flicker {
                0%, 100% { opacity: 0.3; }
                50% { opacity: 0.5; }
            }
            
            .encryption-bg {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                z-index: 1;
                overflow: hidden;
            }
            
            .hash-element {
                position: absolute;
                font-family: 'JetBrains Mono', 'Courier New', monospace;
                font-size: 0.7rem;
                color: rgba(16, 185, 129, 0.4);
                white-space: nowrap;
                animation: calculateHash 3s ease-in-out infinite;
                user-select: none;
                text-shadow: 0 0 10px rgba(16, 185, 129, 0.5), 0 0 20px rgba(16, 185, 129, 0.3);
                letter-spacing: 1px;
            }
            
            .hash-element:nth-child(2n) {
                animation-duration: 2.5s;
                color: rgba(37, 99, 235, 0.35);
                text-shadow: 0 0 10px rgba(37, 99, 235, 0.5), 0 0 20px rgba(37, 99, 235, 0.3);
            }
            
            .hash-element:nth-child(3n) {
                animation-duration: 3.5s;
                color: rgba(6, 182, 212, 0.3);
                text-shadow: 0 0 10px rgba(6, 182, 212, 0.5), 0 0 20px rgba(6, 182, 212, 0.3);
            }
            
            .hash-element:nth-child(4n) {
                animation-duration: 2.8s;
                color: rgba(16, 185, 129, 0.38);
                text-shadow: 0 0 10px rgba(16, 185, 129, 0.5), 0 0 20px rgba(16, 185, 129, 0.3);
            }
            
            .hash-element:nth-child(5n) {
                animation-duration: 3.2s;
                color: rgba(37, 99, 235, 0.32);
                text-shadow: 0 0 10px rgba(37, 99, 235, 0.5), 0 0 20px rgba(37, 99, 235, 0.3);
            }
            
            .hash-element.calculating {
                animation: flicker 0.1s infinite;
            }
            
            /* Professional navigation */
            .security-nav {
                background: rgba(26, 26, 26, 0.98);
                border-bottom: 1px solid rgba(37, 99, 235, 0.2);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
                backdrop-filter: blur(20px);
            }
            
            /* Professional security card */
            .security-card {
                background: rgba(30, 30, 30, 0.4);
                border: 1px solid rgba(37, 99, 235, 0.25);
                border-radius: 12px;
                box-shadow: 
                    0 4px 6px -1px rgba(0, 0, 0, 0.3),
                    0 2px 4px -1px rgba(0, 0, 0, 0.2),
                    inset 0 1px 0 rgba(255, 255, 255, 0.03);
                position: relative;
                transition: all 0.3s ease;
            }
            
            .security-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: linear-gradient(90deg, transparent, rgba(37, 99, 235, 0.4), transparent);
                border-radius: 12px 12px 0 0;
            }
            
            .security-card:hover {
                border-color: rgba(37, 99, 235, 0.5);
                box-shadow: 
                    0 10px 15px -3px rgba(0, 0, 0, 0.4),
                    0 4px 6px -2px rgba(0, 0, 0, 0.3),
                    0 0 20px rgba(37, 99, 235, 0.15);
                transform: translateY(-2px);
                background: rgba(35, 35, 35, 0.6);
            }
            
            /* Professional input */
            .input-security {
                background-color: rgba(26, 26, 26, 0.9);
                border: 1.5px solid rgba(37, 99, 235, 0.25);
                color: #f1f5f9;
                border-radius: 8px;
                transition: all 0.3s ease;
            }
            
            .input-security:hover {
                border-color: rgba(37, 99, 235, 0.4);
                background-color: rgba(30, 30, 30, 0.95);
            }
            
            .input-security:focus {
                background-color: rgba(30, 30, 30, 1);
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15), 0 0 20px rgba(37, 99, 235, 0.08);
                outline: none;
            }
            
            .input-security::placeholder {
                color: rgba(241, 245, 249, 0.4);
            }
            
            /* Professional button */
            .btn-security {
                background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
                border: none;
                color: #ffffff;
                font-weight: 600;
                letter-spacing: 0.5px;
                border-radius: 8px;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
                box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
            }
            
            .btn-security::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s ease;
            }
            
            .btn-security:hover {
                background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.4), 0 4px 6px -2px rgba(37, 99, 235, 0.3);
                transform: translateY(-2px);
            }
            
            .btn-security:hover::before {
                left: 100%;
            }
            
            .btn-security:active {
                transform: translateY(0);
            }
            
            /* Feature card professional style */
            .feature-security {
                background: rgba(30, 30, 30, 0.3);
                border: 1px solid rgba(37, 99, 235, 0.2);
                border-radius: 12px;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }
            
            .feature-security::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(37, 99, 235, 0.08), transparent);
                transition: left 0.6s ease;
            }
            
            .feature-security:hover {
                border-color: rgba(37, 99, 235, 0.4);
                box-shadow: 0 8px 16px rgba(37, 99, 235, 0.15);
                transform: translateY(-4px);
                background: rgba(35, 35, 35, 0.5);
            }
            
            .feature-security:hover::before {
                left: 100%;
            }
            
            /* Trust badge style */
            .trust-badge {
                display: inline-flex;
                align-items: center;
                padding: 4px 12px;
                background: rgba(16, 185, 129, 0.1);
                border: 1px solid rgba(16, 185, 129, 0.3);
                border-radius: 6px;
                color: #3b82f6;
                font-size: 0.75rem;
                font-weight: 600;
                letter-spacing: 0.5px;
            }
            
            /* Security icon glow */
            .icon-security {
                filter: drop-shadow(0 0 8px rgba(37, 99, 235, 0.4));
            }
            
            /* Professional text styles */
            .text-primary {
                color: #3b82f6;
            }
            
            .text-secondary {
                color: #10b981;
            }
            
            .text-accent {
                color: #06b6d4;
            }
            
            /* Footer link styles */
            .footer-link {
                color: #cbd5e1;
                transition: color 0.2s ease;
            }
            
            .footer-link:hover {
                color: #60a5fa;
            }
            
            /* Sticky footer layout */
            main {
                flex: 1 0 auto;
            }
            
            footer {
                flex-shrink: 0;
                margin-top: auto;
            }
            
            /* Mobile responsive styles */
            @media (max-width: 640px) {
                
                /* Footer centering on mobile */
                footer .grid {
                    text-align: center;
                }
                
                footer .grid > div {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                }
                
                footer .flex.items-center {
                    justify-content: center;
                }
                
                /* Navigation adjustments */
                nav .text-2xl {
                    font-size: 1.25rem;
                }
                
                nav .trust-badge {
                    display: none;
                }
                
                nav .btn-security {
                    padding: 0.5rem 0.75rem;
                    font-size: 0.75rem;
                }
                
                nav .btn-security svg {
                    width: 0.875rem;
                    height: 0.875rem;
                }
            }
        </style>
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="min-h-screen relative" style="z-index: 0;">
        <!-- Encryption Background Animation -->
        <div class="encryption-bg" id="encryptionBg"></div>
        
        <nav class="security-nav sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
                <div class="flex justify-between h-16 sm:h-20 items-center">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 flex items-center">
                            <a href="{{ path('app_home') }}" class="inline-flex items-center text-xl sm:text-2xl font-bold transition-colors duration-200" style="color: #60a5fa;">
                                <div class="bg-gradient-to-br from-blue-600 to-blue-500 p-2 sm:p-2.5 rounded-lg mr-2 sm:mr-3 icon-security shadow-lg">
                                    <svg class="h-6 w-6 sm:h-7 sm:w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                    </svg>
                                </div>
                                <span class="trust-badge ml-2 sm:ml-3 text-sm sm:text-sm">DropCrypt</span>
                            </a>
                        </div>
                    </div>
                    <!-- Navigation for NOT logged in users -->
                    <div id="nav-guest" class="flex items-center gap-2 sm:gap-4">
                        <div class="hidden lg:flex items-center gap-2 text-sm" style="color: #cbd5e1;">
                            <svg class="h-4 w-4" style="color: #34d399;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            <span>End-to-End Encrypted</span>
                        </div>
                        
                        <a href="/account/login" class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-medium text-gray-300 hover:text-white transition-colors">
                            <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                            </svg>
                            Login
                        </a>
                        
                        <a href="/account/create" class="btn-security inline-flex items-center px-4 sm:px-5 py-2.5 sm:py-2.5 text-sm font-semibold focus:outline-none">
                            <svg class="h-5 w-5 sm:h-4 sm:w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                            </svg>
                            <span class="hidden sm:inline">Create Account</span>
                            <span class="sm:hidden">Sign Up</span>
                        </a>
                    </div>

                    <!-- Navigation for logged in users -->
                    <div id="nav-user" class="hidden items-center gap-1 sm:gap-2 md:gap-4">
                        <span id="nav-user-id" class="hidden lg:inline-flex text-xs sm:text-sm font-mono text-gray-400 px-2 sm:px-3 py-1 bg-gray-800 bg-opacity-50 rounded"></span>
                        
                        <a href="/dashboard" class="inline-flex items-center px-3 sm:px-3 md:px-4 py-2 sm:py-2 text-xs sm:text-sm font-medium text-gray-300 hover:text-white transition-colors">
                            <svg class="h-6 w-6 sm:h-4 sm:w-4 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                            </svg>
                            <span class="hidden sm:inline">Dashboard</span>
                        </a>
                        
                        <a href="/contacts" class="inline-flex items-center px-3 sm:px-3 md:px-4 py-2 sm:py-2 text-xs sm:text-sm font-medium text-gray-300 hover:text-white transition-colors">
                            <svg class="h-6 w-6 sm:h-4 sm:w-4 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <span class="hidden sm:inline">Contacts</span>
                        </a>
                        
                        <a href="/account/settings" class="inline-flex items-center px-3 sm:px-3 md:px-4 py-2 sm:py-2 text-xs sm:text-sm font-medium text-gray-300 hover:text-white transition-colors">
                            <svg class="h-6 w-6 sm:h-4 sm:w-4 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            <span class="hidden sm:inline">Settings</span>
                        </a>
                        
                        <button id="nav-logout-btn" class="inline-flex items-center px-3 sm:px-3 md:px-4 py-2 sm:py-2 text-xs sm:text-sm font-medium text-red-400 hover:text-red-300 transition-colors">
                            <svg class="h-6 w-6 sm:h-4 sm:w-4 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            <span class="hidden sm:inline">Logout</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <main class="flex-1 flex flex-col relative" style="z-index: 2;">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="animate__animated animate__fadeIn mb-4 p-4 security-card {% if label == 'success' %}{% else %}{% endif %}" style="{% if label == 'success' %}border-color: rgba(16, 185, 129, 0.4); color: #10b981;{% else %}border-color: rgba(239, 68, 68, 0.4); color: #ef4444;{% endif %}">
                        <div class="flex items-center">
                            {% if label == 'success' %}
                                <svg class="h-5 w-5 mr-2" style="color: #10b981;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            {% else %}
                                <svg class="h-5 w-5 mr-2" style="color: #ef4444;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            {% endif %}
                            <span>{{ message }}</span>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="hidden md:block border-t border-gray-800 relative" style="z-index: 2; border-color: rgba(37, 99, 235, 0.2); margin-top: auto;">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
                    <div class="text-center md:text-left">
                        <div class="flex items-center justify-center md:justify-start mb-4">
                            <div class="bg-gradient-to-br from-blue-600 to-blue-500 p-2 rounded-lg mr-3 icon-security">
                                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
