        {# Encryption Background Animation #}
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const encryptionBg = document.getElementById('encryptionBg');
            if (!encryptionBg) {
                console.error('Encryption background container not found');
                return;
            }
            
            // Generate random hashsum-like strings
            function generateHash() {
                const chars = '0123456789abcdef';
                let hash = '';
                for (let i = 0; i < 64; i++) {
                    hash += chars[Math.floor(Math.random() * chars.length)];
                }
                return hash;
            }
            
            // Generate encryption-related strings
            function generateEncryptionString() {
                const types = [
                    generateHash(), // SHA-256 hash
                    'AES-256-GCM',
                    '0x' + generateHash().substring(0, 16),
                    'RSA-4096',
                    generateHash().substring(0, 32) + '...',
                    'ECDSA-P256',
                    'PBKDF2-SHA256',
                    '0x' + generateHash().substring(0, 8),
                    generateHash().substring(0, 40),
                    'HMAC-SHA256',
                    'ChaCha20-Poly1305',
                    generateHash().substring(0, 24)
                ];
                return types[Math.floor(Math.random() * types.length)];
            }
            
            // Create hash element with calculating effect
            function createHashElement() {
                const element = document.createElement('div');
                element.className = 'hash-element calculating';
                
                // Start with placeholder
                element.textContent = '...';
                
                // Random position across the screen
                const startX = Math.random() * 90;
                const startY = Math.random() * 90;
                element.style.left = startX + '%';
                element.style.top = startY + '%';
                
                // Random delay
                element.style.animationDelay = (Math.random() * 2) + 's';
                
                // Random animation duration
                const duration = 2.5 + (Math.random() * 1.5);
                element.style.animationDuration = duration + 's';
                
                encryptionBg.appendChild(element);
                
                // Simulate calculation - show partial hash first
                setTimeout(() => {
                    const partialHash = generateHash().substring(0, 16) + '...';
                    element.textContent = partialHash;
                }, 200);
                
                // Show full hash after calculation
                setTimeout(() => {
                    element.textContent = generateEncryptionString();
                    element.classList.remove('calculating');
                }, 600);
                
                // Remove element after animation completes
                setTimeout(() => {
                    if (element.parentNode) {
                        element.parentNode.removeChild(element);
                    }
                }, (duration + 0.5) * 1000);
            }
            
            // Create initial hash elements immediately
            for (let i = 0; i < 20; i++) {
                setTimeout(() => createHashElement(), i * 300);
            }
            
            // Continuously create new hash elements (calculating continuously)
            setInterval(() => {
                if (encryptionBg.children.length < 30) {
                    createHashElement();
                }
            }, 400);
        });
        </script>

        <!-- Dynamic Navbar based on login status -->
        <script>
        (function() {
            const sessionToken = localStorage.getItem('dropcrypt_session');
            const anonymousId = localStorage.getItem('dropcrypt_anonymous_id');
            const isLoggedIn = !!(sessionToken && anonymousId);

            const navGuest = document.getElementById('nav-guest');
            const navUser = document.getElementById('nav-user');
            const navUserId = document.getElementById('nav-user-id');
            const navLogoutBtn = document.getElementById('nav-logout-btn');

            if (isLoggedIn) {
                // Show logged in navigation
                navGuest.classList.add('hidden');
                navUser.classList.remove('hidden');
                navUser.classList.add('flex');
                
                // Display user ID (shortened for mobile)
                if (navUserId && anonymousId) {
                    navUserId.textContent = anonymousId;
                }

                // Logout handler
                if (navLogoutBtn) {
                    navLogoutBtn.addEventListener('click', async function(e) {
                        e.preventDefault();
                        
                        // Call logout API
                        try {
                            await fetch('/api/accounts/logout', {
                                method: 'POST',
                                headers: { 'Authorization': 'Bearer ' + sessionToken }
                            });
                        } catch (error) {
                            console.error('Logout API error:', error);
                        }
                        
                        // Complete storage cleanup
                        clearAllDropCryptData();
                        
                        // Redirect to home
                        window.location.href = '/';
                    });
                }
            } else {
                // Show guest navigation
                navGuest.classList.remove('hidden');
                navGuest.classList.add('flex');
                navUser.classList.add('hidden');
            }
            
            /**
             * Comprehensive cleanup function
             * Removes all DropCrypt data from localStorage, sessionStorage, and memory
             */
            function clearAllDropCryptData() {
                // 1. Remove known DropCrypt keys from localStorage
                const knownKeys = [
                    'dropcrypt_session',
                    'dropcrypt_anonymous_id',
                    'dropcrypt_public_key',
                    'dropcrypt_private_key'
                ];
                
                knownKeys.forEach(key => {
                    localStorage.removeItem(key);
                });
                
                // 2. Scan and remove any other "dropcrypt_*" prefixed keys
                const toRemove = [];
                for (let i = 0; i < localStorage.length; i++) {
                    const key = localStorage.key(i);
                    if (key && key.startsWith('dropcrypt_')) {
                        toRemove.push(key);
                    }
                }
                
                toRemove.forEach(key => {
                    localStorage.removeItem(key);
                });
                
                // 3. Clear entire sessionStorage (safe - session-specific)
                sessionStorage.clear();
                
                console.log('✓ All DropCrypt data cleared');
            }
            
            // Make clearAllDropCryptData available globally
            window.clearAllDropCryptData = clearAllDropCryptData;
        })();
        </script>
        
