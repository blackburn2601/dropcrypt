{% extends 'base.html.twig' %}

{% block title %}Chat - DropCrypt{% endblock %}

{% block body %}
<style>
    /* Make main element fill height for chat page */
    main { overflow: hidden; }
    
    /* Transparent gradient overlay for chat */
    .chat-gradient-overlay {
        background: linear-gradient(135deg, 
            rgba(17, 24, 39, 0.5) 0%,    /* gray-900 with 50% opacity */
            rgba(30, 58, 138, 0.4) 50%,  /* blue-900 with 40% opacity */
            rgba(88, 28, 135, 0.3) 100%  /* purple-900 with 30% opacity */
        );
    }
</style>
<div class="absolute inset-0 chat-gradient-overlay flex flex-col">
    <!-- Chat Header -->
    <div class="flex-shrink-0 bg-gray-900 bg-opacity-50 backdrop-blur-lg border-b border-gray-800 px-2 sm:px-4 py-2 sm:py-3">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <a href="/dashboard" class="text-gray-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                </a>
                <div>
                    <h2 id="contact-name" class="text-base font-semibold text-white"></h2>
                    <p id="contact-id" class="text-xs text-gray-400"></p>
                </div>
            </div>
            <button id="btn-contact-info" class="text-gray-400 hover:text-white p-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Messages Container -->
    <div class="flex-1 overflow-y-auto px-2 sm:px-4 py-3 sm:py-6" id="messages-container">
        <div class="max-w-4xl mx-auto space-y-2 sm:space-y-4" id="messages-list">
            <!-- Messages will be loaded here -->
        </div>

        <div id="messages-loader" class="text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-400"></div>
            <p class="text-gray-400 mt-2 text-sm">Loading messages...</p>
        </div>

        <div id="no-messages" class="hidden text-center py-8 sm:py-12 text-gray-400">
            <svg class="w-12 h-12 sm:w-16 sm:h-16 mx-auto mb-3 sm:mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <p class="text-base sm:text-lg">No messages yet</p>
            <p class="text-xs sm:text-sm mt-1">Start the conversation below</p>
        </div>

        <!-- Decryption error -->
        <div id="decrypt-error" class="hidden max-w-4xl mx-auto">
            <div class="alert-error">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>Unable to decrypt some messages. This may occur if you're on a different device.</span>
            </div>
        </div>
    </div>

    <!-- Message Input -->
    <div class="flex-shrink-0 bg-gray-900 bg-opacity-50 backdrop-blur-lg border-t border-gray-800 px-2 sm:px-4 py-2 sm:py-4">
        <div class="max-w-4xl mx-auto">
            <div class="flex items-stretch space-x-2 sm:space-x-3">
                <div class="flex-1 flex items-center">
                    <textarea 
                        id="message-input" 
                        rows="1"
                        class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 sm:px-4 py-2.5 sm:py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 resize-none"
                        placeholder="Type a message..."
                        style="max-height: 120px; min-height: 44px;"
                    ></textarea>
                </div>
                <button 
                    id="btn-send" 
                    class="btn-security px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                    style="min-height: 44px;"
                    disabled
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
            
            <div id="send-error" class="hidden mt-2 text-red-400 text-sm"></div>
            
            <div class="flex items-center justify-between mt-2 text-xs text-gray-500">
                <span id="char-count">0 / 5000</span>
            </div>
        </div>
    </div>
</div>

<script src="/js/crypto-helper.js?v=4"></script>
<script>
(async function() {
    const crypto = new CryptoHelper();
    const urlPath = window.location.pathname;
    const otherUserId = urlPath.split('/').pop();
    
    // Check authentication
    const sessionToken = localStorage.getItem('dropcrypt_session');
    const anonymousId = localStorage.getItem('dropcrypt_anonymous_id');
    const senderPublicKey = localStorage.getItem('dropcrypt_public_key'); // Sender's own public key

    if (!sessionToken || !anonymousId) {
        window.location.href = '/account/login';
        return;
    }

    // Private key cache (in RAM only, expires after 15 minutes)
    let privateKeyCache = null;
    let keyExpiryTime = null;
    const KEY_CACHE_LIFETIME = 15 * 60 * 1000; // 15 minutes
    
    let recipientPublicKey = null;
    let pollingInterval;
    let isFirstLoad = true;

    // Load private key (with time-limited RAM cache, no password storage)
    async function loadPrivateKey() {
        try {
            // Check if cached key is still valid
            if (privateKeyCache && keyExpiryTime && Date.now() < keyExpiryTime) {
                console.log('Using cached private key');
                return privateKeyCache;
            }

            // Cache expired or doesn't exist
            const encryptedKey = crypto.loadEncryptedPrivateKey();
            if (!encryptedKey) {
                console.warn('No private key found in storage - this is normal on first login from a new device');
                document.getElementById('decrypt-error').classList.remove('hidden');
                return null;
            }

            // Prompt for password (password is NEVER stored)
            const pwd = prompt('🔐 Enter your password to decrypt messages:\n\n(Key will be cached for 15 minutes)');
            
            if (!pwd) {
                // User cancelled
                document.getElementById('decrypt-error').classList.remove('hidden');
                return null;
            }

            try {
                // Decrypt private key with password
                const decryptedKey = await crypto.getPrivateKey(pwd);
                
                // Cache key in RAM only (NOT password!)
                privateKeyCache = decryptedKey;
                keyExpiryTime = Date.now() + KEY_CACHE_LIFETIME;
                
                console.log('Private key cached until:', new Date(keyExpiryTime).toLocaleTimeString());
                
                return decryptedKey;
            } catch (e) {
                alert('❌ Incorrect password. Messages cannot be decrypted.');
                document.getElementById('decrypt-error').classList.remove('hidden');
                return null;
            }
        } catch (error) {
            console.error('Failed to load private key:', error);
            document.getElementById('decrypt-error').classList.remove('hidden');
            return null;
        }
    }

    // Load recipient info
    async function loadRecipientInfo() {
        try {
            const response = await fetch(`/api/users/${otherUserId}/public-key`, {
                headers: { 'Authorization': 'Bearer ' + sessionToken }
            });

            if (!response.ok) throw new Error('User not found');

            const data = await response.json();
            recipientPublicKey = data.publicKey;

            // Try to get contact info for nickname
            const contactResponse = await fetch('/api/contacts', {
                headers: { 'Authorization': 'Bearer ' + sessionToken }
            });

            if (contactResponse.ok) {
                const contacts = await contactResponse.json();
                const contact = contacts.contacts.find(c => c.userId === otherUserId);
                
                document.getElementById('contact-name').textContent = contact?.nickname || otherUserId;
            } else {
                document.getElementById('contact-name').textContent = otherUserId;
            }

            document.getElementById('contact-id').textContent = otherUserId;
        } catch (error) {
            console.error('Failed to load recipient info:', error);
            alert('User not found');
            window.location.href = '/dashboard';
        }
    }

    // Load and decrypt messages
    async function loadMessages() {
        try {
            const container = document.getElementById('messages-container');
            
            // Check if user was already at the bottom before loading
            const wasAtBottom = container.scrollHeight - container.scrollTop - container.clientHeight < 50;
            
            const response = await fetch(`/api/direct-messages/thread/${otherUserId}`, {
                headers: { 'Authorization': 'Bearer ' + sessionToken }
            });

            if (!response.ok) throw new Error('Failed to load messages');

            const data = await response.json();
            console.log('Loaded messages:', data.messages.length);
            const messagesList = document.getElementById('messages-list');
            const messagesLoader = document.getElementById('messages-loader');
            const noMessages = document.getElementById('no-messages');

            messagesLoader.classList.add('hidden');

            if (data.messages.length === 0) {
                noMessages.classList.remove('hidden');
                return;
            }

            noMessages.classList.add('hidden');

            // Decrypt and display messages
            const decryptedMessages = [];

            for (const msg of data.messages.reverse()) {
                let content = '[Encrypted]';
                
                try {
                    // Check if key cache is still valid
                    if (privateKeyCache && (!keyExpiryTime || Date.now() >= keyExpiryTime)) {
                        // Key expired, need to re-prompt
                        privateKeyCache = await loadPrivateKey();
                    }
                    
                    if (privateKeyCache && msg.encryptedKey) {
                        console.log('🔓 Attempting to decrypt message:', {
                            messageId: msg.messageId,
                            isSender: msg.isSender,
                            hasEncryptedContent: !!msg.encryptedContent,
                            encryptedContentLength: msg.encryptedContent?.length,
                            hasEncryptedKey: !!msg.encryptedKey,
                            encryptedKeyLength: msg.encryptedKey?.length,
                            hasPrivateKey: !!privateKeyCache
                        });
                        
                        // Decrypt message (works for both sent and received)
                        content = await crypto.decryptMessageComplete(
                            msg.encryptedContent,
                            msg.encryptedKey,
                            privateKeyCache
                        );
                        console.log('✅ Message decrypted successfully:', msg.messageId);
                    } else if (!privateKeyCache) {
                        content = '[Private key not available - cannot decrypt]';
                        console.warn('No private key cache available');
                    } else if (!msg.encryptedKey) {
                        content = '[Encryption key missing]';
                        console.warn('No encrypted key in message:', msg.messageId);
                    }
                } catch (error) {
                    console.error('❌ Decryption failed for message:', msg.messageId);
                    console.error('Error:', error);
                    console.error('Error stack:', error.stack);
                    console.error('Message details:', {
                        messageId: msg.messageId,
                        isSender: msg.isSender,
                        hasEncryptedContent: !!msg.encryptedContent,
                        hasEncryptedKey: !!msg.encryptedKey,
                        hasPrivateKey: !!privateKeyCache,
                        encryptedContent: msg.encryptedContent?.substring(0, 50) + '...',
                        encryptedKey: msg.encryptedKey?.substring(0, 50) + '...'
                    });
                    content = '[Failed to decrypt]';
                }

                decryptedMessages.push({...msg, decrypted: content});

                // Mark as read if it's a received message
                if (!msg.isSender && !msg.isRead) {
                    fetch(`/api/direct-messages/${msg.messageId}/read`, {
                        method: 'PUT',
                        headers: { 'Authorization': 'Bearer ' + sessionToken }
                    });
                }
            }

            messagesList.innerHTML = decryptedMessages.map(msg => {
                // Determine checkmark status for sent messages
                let statusIcon = '';
                if (msg.isSender) {
                    if (msg.isRead) {
                        // Two checkmarks for read messages (green)
                        statusIcon = '<span class="text-[10px] sm:text-xs font-bold" title="Read" style="letter-spacing: -2px; color: #4ade80;">✓✓</span>';
                    } else {
                        // Single checkmark for sent but not read (orange)
                        statusIcon = '<span class="text-[10px] sm:text-xs" title="Sent" style="color: #fb923c;">✓</span>';
                    }
                }
                
                return `
                    <div class="flex ${msg.isSender ? 'justify-end' : 'justify-start'} px-1 sm:px-0">
                        <div class="${msg.isSender ? 'bg-blue-600' : 'bg-gray-800'} rounded-lg px-2.5 sm:px-4 py-2 sm:py-3" style="max-width: 280px;">
                            <p class="text-white break-words text-base sm:text-sm leading-relaxed">${msg.decrypted}</p>
                            <div class="flex items-center justify-between mt-0.5 sm:mt-1 space-x-2">
                                <span class="text-[10px] sm:text-xs ${msg.isSender ? 'text-blue-200' : 'text-gray-400'}">
                                    ${new Date(msg.sentAt).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'})}
                                </span>
                                ${statusIcon}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            // Scroll to bottom on first load or if user was already at the bottom
            if (isFirstLoad || wasAtBottom) {
                setTimeout(() => {
                    container.scrollTop = container.scrollHeight;
                }, 10);
                isFirstLoad = false;
            }
        } catch (error) {
            console.error('Failed to load messages:', error);
        }
    }

    // Send message
    const messageInput = document.getElementById('message-input');
    const btnSend = document.getElementById('btn-send');
    const charCount = document.getElementById('char-count');
    const sendError = document.getElementById('send-error');

    messageInput.addEventListener('input', () => {
        const length = messageInput.value.length;
        charCount.textContent = `${length} / 5000`;
        btnSend.disabled = length === 0 || length > 5000;
        
        // Auto-resize textarea
        messageInput.style.height = 'auto';
        messageInput.style.height = messageInput.scrollHeight + 'px';
    });

    messageInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            btnSend.click();
        }
    });

    btnSend.addEventListener('click', async () => {
        const content = messageInput.value.trim();
        
        // Debug logging
        console.log('Send button clicked');
        console.log('Content:', content ? 'present' : 'empty');
        console.log('Recipient public key:', recipientPublicKey ? 'present' : 'missing');
        console.log('Sender public key:', senderPublicKey ? 'present' : 'missing');
        
        if (!content || !recipientPublicKey || !senderPublicKey) {
            if (!senderPublicKey) {
                sendError.textContent = 'Your public key is not available. Please log in again.';
                sendError.classList.remove('hidden');
            }
            return;
        }

        try {
            btnSend.disabled = true;
            sendError.classList.add('hidden');

            // Encrypt message for both sender and recipient
            const encrypted = await crypto.encryptMessageForBoth(content, recipientPublicKey, senderPublicKey);
            
            console.log('Encrypted data:', {
                hasContent: !!encrypted.encryptedContent,
                hasRecipientKey: !!encrypted.encryptedKeyForRecipient,
                hasSenderKey: !!encrypted.encryptedKeyForSender
            });

            const payload = {
                recipientId: otherUserId,
                encryptedContent: encrypted.encryptedContent,
                encryptedKeyForRecipient: encrypted.encryptedKeyForRecipient,
                encryptedKeyForSender: encrypted.encryptedKeyForSender
            };
            
            console.log('Sending payload:', payload);

            // Send message
            const response = await fetch('/api/direct-messages', {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + sessionToken,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error('Failed to send message');

            messageInput.value = '';
            messageInput.style.height = 'auto';
            charCount.textContent = '0 / 5000';
            
            // Reload messages
            await loadMessages();
        } catch (error) {
            console.error('Send error:', error);
            sendError.textContent = error.message;
            sendError.classList.remove('hidden');
        } finally {
            btnSend.disabled = messageInput.value.length === 0;
        }
    });

    // Contact info modal
    document.getElementById('btn-contact-info').addEventListener('click', () => {
        alert(`Anonymous ID: ${otherUserId}\n\nYou can add this user to your contacts for a custom nickname.`);
    });

    // Initialize
    privateKeyCache = await loadPrivateKey();
    await loadRecipientInfo();
    await loadMessages();

    // Poll for new messages every 3 seconds
    pollingInterval = setInterval(loadMessages, 3000);
    
    // Clear private key cache when page is about to close
    window.addEventListener('beforeunload', () => {
        privateKeyCache = null;
        keyExpiryTime = null;
        console.log('Private key RAM cache cleared');
    });
    
    // Also clear on visibility change (tab switch, minimize, etc.)
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            // User switched away - clear sensitive data from RAM
            privateKeyCache = null;
            keyExpiryTime = null;
            console.log('Private key RAM cache cleared (tab hidden)');
        }
    });
})();
</script>
{% endblock %}

