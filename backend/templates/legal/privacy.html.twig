{% extends 'base.html.twig' %}

{% block title %}Privacy Policy - DropCrypt{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="security-card p-8">
            <div class="flex items-center mb-8">
                <div class="bg-gradient-to-br from-emerald-600 to-emerald-500 p-3 rounded-lg mr-4 icon-security">
                    <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <h1 class="text-3xl font-extrabold" style="color: #f1f5f9;">Privacy Policy</h1>
            </div>

            <div class="prose prose-invert max-w-none" style="color: #e2e8f0;">
                <div class="space-y-6">
                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">1. Data Protection Overview</h2>
                        <p style="color: #e2e8f0;">DropCrypt is committed to protecting your privacy. This privacy policy explains how we handle your data when you use our secure messaging service.</p>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">2. End-to-End Encryption</h2>
                        <div class="space-y-3">
                            <p style="color: #e2e8f0;">All messages are encrypted using AES-256-GCM encryption before transmission. The encryption keys are generated on your device and never sent to our servers.</p>
                            <p style="color: #e2e8f0;"><strong style="color: #cbd5e1;">We cannot read your messages.</strong> Only you and the recipient with the correct decryption key can access the message content.</p>
                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">3. Data We Collect</h2>
                        <div class="space-y-3">
                            <div>
                                <h3 class="text-xl font-semibold mb-2" style="color: #60a5fa;">Message Data</h3>
                                <ul class="list-disc list-inside space-y-2" style="color: #e2e8f0;">
                                    <li>Encrypted message content (we cannot decrypt it)</li>
                                    <li>Access token (unique identifier for message retrieval)</li>
                                    <li>Key hash (for verification, not the actual key)</li>
                                    <li>Expiration timestamp</li>
                                    <li>Read status (boolean flag)</li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold mb-2" style="color: #60a5fa;">Technical Data</h3>
                                <ul class="list-disc list-inside space-y-2" style="color: #e2e8f0;">
                                    <li>IP addresses (for security and abuse prevention)</li>
                                    <li>Browser type and version</li>
                                    <li>Access timestamps</li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">4. Data Storage</h2>
                        <div class="space-y-3">
                            <p style="color: #e2e8f0;">Messages are stored in encrypted form on our servers until:</p>
                            <ul class="list-disc list-inside space-y-2" style="color: #e2e8f0;">
                                <li>They are read by the recipient (one-time view)</li>
                                <li>They expire based on the selected expiration time</li>
                                <li>They are automatically deleted from our database</li>
                            </ul>
                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">5. Your Rights</h2>
                        <div class="space-y-2">
                            <p style="color: #e2e8f0;">Under GDPR and other privacy laws, you have the right to:</p>
                            <ul class="list-disc list-inside space-y-2" style="color: #e2e8f0;">
                                <li>Access your personal data</li>
                                <li>Request deletion of your data</li>
                                <li>Object to processing of your data</li>
                                <li>Data portability</li>
                            </ul>
                            <p class="mt-4" style="color: #e2e8f0;">To exercise these rights, please contact us at <a href="mailto:privacy@dropcrypt.com" class="hover:underline" style="color: #60a5fa;">privacy@dropcrypt.com</a></p>
                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">6. Cookies and Tracking</h2>
                        <p style="color: #e2e8f0;">We do not use tracking cookies or analytics tools that collect personal information. Our service operates without persistent user tracking.</p>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">7. Third-Party Services</h2>
                        <p style="color: #e2e8f0;">We do not share your data with third parties. All encryption and decryption happens client-side using your browser's Web Crypto API.</p>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">8. Contact</h2>
                        <p style="color: #e2e8f0;">For questions about this privacy policy, please contact:</p>
                        <p class="mt-2" style="color: #e2e8f0;">
                            <strong style="color: #cbd5e1;">Email:</strong> <a href="mailto:privacy@dropcrypt.com" class="hover:underline" style="color: #60a5fa;">privacy@dropcrypt.com</a>
                        </p>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4" style="color: #60a5fa;">9. Changes to This Policy</h2>
                        <p style="color: #e2e8f0;">We may update this privacy policy from time to time. The current version is always available on this page. Last updated: {{ "now"|date("F Y") }}</p>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

