{% extends 'base.html.twig' %}

{% block title %}New Message{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto">
        <div class="security-card p-4 sm:p-8">
            <div class="flex items-center mb-6 sm:mb-8">
                <div class="bg-gradient-to-br from-blue-600 to-blue-500 p-2 sm:p-3 rounded-lg mr-3 sm:mr-4 flex-shrink-0 icon-security">
                    <svg class="h-6 w-6 sm:h-7 sm:w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <h1 class="text-2xl sm:text-3xl font-extrabold" style="color: #f1f5f9;">New Secure Message</h1>
                    <p class="text-xs sm:text-sm mt-1" style="color: #cbd5e1;">Your message will be encrypted with AES-256-GCM encryption before transmission. Only the recipient with the correct key can decrypt it.</p>
                </div>
            </div>

            <div id="formContainer" class="transition-opacity duration-500 ease-in-out">
                <!-- Security Info Banner -->
                <div class="mb-4 sm:mb-6 p-3 sm:p-4 rounded-lg" style="background: rgba(37, 99, 235, 0.1); border: 1px solid rgba(37, 99, 235, 0.3);">
                    <div class="flex items-start">
                        <svg class="h-4 w-4 sm:h-5 sm:w-5 mr-2 sm:mr-3 flex-shrink-0 mt-0.5" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <div>
                            <p class="text-xs sm:text-sm font-semibold mb-1" style="color: #60a5fa;">Security Information</p>
                            <ul class="text-xs space-y-1" style="color: #cbd5e1;">
                                <li>• Encryption happens on your device - we never see your message</li>
                                <li>• Each message gets a unique encryption key generated randomly</li>
                                <li>• Messages can only be viewed once and then are permanently deleted</li>
                                <li>• Choose an expiration time that fits your needs (1 hour to 7 days)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <form id="messageForm" class="space-y-4 sm:space-y-6">
                <div>
                    <label for="message" class="flex items-center text-xs sm:text-sm font-semibold mb-2" style="color: #e2e8f0;">
                        <svg class="h-3 w-3 sm:h-4 sm:w-4 mr-2" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Message Content
                        <span class="ml-2 text-xs font-normal" style="color: #94a3b8;">(Required)</span>
                    </label>
                    <div class="mt-1 relative">
                        <textarea
                            id="message"
                            name="message"
                            rows="8"
                            placeholder="Enter your secure message here...&#10;&#10;You can type multiple lines of text.&#10;Your message will be encrypted before it's sent to our servers.&#10;&#10;Examples:&#10;• Passwords or credentials&#10;• API keys or tokens&#10;• Personal information&#10;• Confidential notes"
                            class="input-security px-3 sm:px-4 py-2 sm:py-3 pr-10 block w-full text-sm sm:text-base transition-colors resize-y"
                            style="min-height: 200px; font-family: 'Inter', sans-serif; line-height: 1.6;"
                            required
                        ></textarea>
                    </div>
                    <p class="mt-2 text-xs" style="color: #94a3b8;">
                        <svg class="inline h-3 w-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Maximum length: 10,000 characters.
                    </p>
                </div>

                <div>
                    <label for="expiration" class="flex items-center text-xs sm:text-sm font-semibold mb-2" style="color: #e2e8f0;">
                        <svg class="h-3 w-3 sm:h-4 sm:w-4 mr-2" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Message Expiration Time
                        <span class="ml-2 text-xs font-normal" style="color: #94a3b8;">(Required)</span>
                    </label>
                    <div class="mt-1 relative">
                        <select
                            id="expiration"
                            name="expiration"
                            class="input-security px-3 sm:px-4 py-2 sm:py-3 pl-8 sm:pl-10 pr-8 sm:pr-10 block w-full text-sm sm:text-base transition-colors appearance-none"
                        >
                            <option value="3600">1 hour - Quick temporary messages</option>
                            <option value="21600">6 hours - Short-term sharing</option>
                            <option value="43200">12 hours - Half-day access</option>
                            <option value="86400" selected>24 hours - One full day (Recommended)</option>
                            <option value="604800">7 days - Extended access</option>
                        </select>
                        <div class="absolute inset-y-0 left-0 pl-2 sm:pl-3 flex items-center pointer-events-none">
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" style="color: #94a3b8;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div class="absolute inset-y-0 right-0 pr-2 sm:pr-3 flex items-center pointer-events-none">
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" style="color: #94a3b8;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </div>
                    </div>
                    <p class="mt-2 text-xs" style="color: #94a3b8;">
                        <svg class="inline h-3 w-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        The message will automatically expire and be deleted after the selected time, even if not viewed.
                    </p>
                </div>

                <div>
                    <button
                        type="submit"
                        class="btn-security w-full flex justify-center items-center py-3 sm:py-4 px-4 sm:px-6 text-sm sm:text-base font-semibold focus:outline-none"
                    >
                        <svg class="h-5 w-5 sm:h-6 sm:w-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Generate Secure Link
                    </button>
                </div>
            </form>
            </div>

            <div id="result" class="hidden mt-6 sm:mt-8 animate__animated animate__fadeIn">
                <div class="security-card p-4 sm:p-6" style="border-color: rgba(16, 185, 129, 0.4);">
                    <div class="flex items-center mb-3 sm:mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-gradient-to-br from-emerald-600 to-emerald-500 p-2 rounded-lg icon-security">
                                <svg class="h-5 w-5 sm:h-6 sm:w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-3 sm:ml-4 flex-1 min-w-0">
                            <h3 class="text-base sm:text-lg font-bold" style="color: #34d399;">Message Created Successfully!</h3>
                        </div>
                    </div>
                    <div class="text-xs sm:text-sm" style="color: #e2e8f0;">
                        <p class="mb-2">Share this secure link with the recipient:</p>
                                <div class="mt-2 relative">
                                    <input
                                        type="text"
                                        id="messageLink"
                                        readonly
                                        class="input-security px-3 sm:px-4 py-2 sm:py-3 pr-20 sm:pr-24 block w-full text-xs sm:text-sm transition-colors"
                                    >
                                    <button
                                        onclick="copyToClipboard(event)"
                                        class="absolute inset-y-0 right-0 inline-flex items-center px-3 sm:px-4 border-l text-xs sm:text-sm font-semibold focus:outline-none transition-colors rounded-r-md"
                                        style="border-color: rgba(37, 99, 235, 0.3); color: #60a5fa; background: rgba(26, 26, 26, 0.9);"
                                        onmouseover="this.style.background='rgba(37, 99, 235, 0.15)';"
                                        onmouseout="this.style.background='rgba(26, 26, 26, 0.9)';"
                                    >
                                        <svg class="h-3 w-3 sm:h-4 sm:w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                        </svg>
                                        <span class="hidden sm:inline">Copy</span>
                                    </button>
                                </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/encryption.js') }}"></script>
<script>
document.getElementById('messageForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const message = document.getElementById('message').value;
    const expirationSeconds = parseInt(document.getElementById('expiration').value);

    try {
        // Generate encryption key
        const key = await MessageEncryption.generateKey();
        const keyString = await MessageEncryption.exportKey(key);

        // Encrypt the message
        const encryptedContent = await MessageEncryption.encrypt(message, key);

        // Hash the key for storage
        const keyHash = await MessageEncryption.hashKey(keyString);

        // Calculate expiration time
        const expiresAt = new Date(Date.now() + expirationSeconds * 1000).toISOString();

        // Send to backend
        const response = await fetch('/message/api/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                content: encryptedContent,
                keyHash: keyHash,
                expiresAt: expiresAt
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || 'Failed to create message');
        }

        // Hide the form with fade-out animation
        const formContainer = document.getElementById('formContainer');
        formContainer.style.opacity = '0';
        formContainer.style.transition = 'opacity 0.5s ease-in-out, max-height 0.5s ease-in-out';
        
        setTimeout(() => {
            formContainer.style.display = 'none';
            
            // Show success message with link
            const messageLink = `${window.location.origin}/message/${data.accessToken}?key=${encodeURIComponent(keyString)}`;
            document.getElementById('messageLink').value = messageLink;
            const resultDiv = document.getElementById('result');
            resultDiv.classList.remove('hidden');
            
            // Scroll to the result section smoothly
            setTimeout(() => {
                resultDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }, 500);

        document.getElementById('messageForm').reset();

    } catch (error) {
        console.error('Error:', error);
        alert('Failed to create message: ' + error.message);
    }
});

function copyToClipboard(event) {
    const linkInput = document.getElementById('messageLink');
    linkInput.select();
    linkInput.setSelectionRange(0, 99999); // For mobile devices
    
    const button = event ? event.target.closest('button') : document.querySelector('button[onclick*="copyToClipboard"]');
    const originalText = button.innerHTML;
    
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(linkInput.value).then(() => {
            // Show success feedback
            button.innerHTML = '<svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Copied!';
            button.classList.add('bg-green-100', 'text-green-700');
            setTimeout(() => {
                button.innerHTML = originalText;
                button.classList.remove('bg-green-100', 'text-green-700');
            }, 2000);
        }).catch(() => {
            // Fallback for older browsers
            document.execCommand('copy');
            alert('Link copied to clipboard!');
        });
    } else {
        // Fallback for older browsers
        document.execCommand('copy');
        button.innerHTML = '<svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Copied!';
        button.classList.add('bg-green-100', 'text-green-700');
        setTimeout(() => {
            button.innerHTML = originalText;
            button.classList.remove('bg-green-100', 'text-green-700');
        }, 2000);
    }
}
</script>
{% endblock %} 