{% extends 'base.html.twig' %}

{% block title %}Welcome to DropCrypt{% endblock %}

{% block body %}
<div class="animate__animated animate__fadeIn">
    <div class="text-center py-16">
        <div class="flex justify-center mb-8">
            <div class="border-2 border-00ff88 p-6" style="border-color: #00ff88; box-shadow: 0 0 30px rgba(0, 255, 136, 0.5);">
                <svg class="h-20 w-20" style="color: #00ff88; filter: drop-shadow(0 0 10px #00ff88);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
        </div>
        <h1 class="text-5xl font-extrabold sm:text-6xl sm:tracking-tight lg:text-7xl mb-6 glitch-text" data-text="SECURE MESSAGE SHARING" style="color: #00ff88; text-shadow: 0 0 10px #00ff88;">
            SECURE MESSAGE SHARING
        </h1>
        <p class="mt-5 max-w-2xl mx-auto text-xl font-medium" style="color: #00ffff;">
            <span class="terminal-prompt"></span>Share sensitive information securely with end-to-end encryption
        </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="feature-hacker p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 border-2 border-00ff88 p-3" style="border-color: #00ff88;">
                    <svg class="h-8 w-8" style="color: #00ff88; filter: drop-shadow(0 0 5px #00ff88);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #00ff88;">[ENCRYPTION]</h3>
                    <p class="text-sm leading-relaxed" style="color: #00ffff;">Your messages are encrypted and can only be read by the intended recipient.</p>
                </div>
            </div>
        </div>

        <div class="feature-hacker p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 border-2 border-00ff88 p-3" style="border-color: #00ff88;">
                    <svg class="h-8 w-8" style="color: #00ff88; filter: drop-shadow(0 0 5px #00ff88);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #00ff88;">[SELF-DESTRUCT]</h3>
                    <p class="text-sm leading-relaxed" style="color: #00ffff;">Messages automatically delete themselves after being read.</p>
                </div>
            </div>
        </div>

        <div class="feature-hacker p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 border-2 border-00ff88 p-3" style="border-color: #00ff88;">
                    <svg class="h-8 w-8" style="color: #00ff88; filter: drop-shadow(0 0 5px #00ff88);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #00ff88;">[SECURE]</h3>
                    <p class="text-sm leading-relaxed" style="color: #00ffff;">Built with security and privacy as the top priorities.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-16 text-center">
        <a href="{{ path('app_message_new') }}" class="btn-hacker inline-flex items-center px-8 py-4 text-lg font-bold focus:outline-none">
            <svg class="mr-3 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            INITIATE TRANSMISSION
            <svg class="ml-3 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
        </a>
    </div>
</div>
{% endblock %} 