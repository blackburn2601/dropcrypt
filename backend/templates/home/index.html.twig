{% extends 'base.html.twig' %}

{% block title %}Welcome to DropCrypt{% endblock %}

{% block body %}
<style>
    /* Transparent gradient overlay for home page */
    .home-gradient-overlay {
        background: linear-gradient(135deg, 
            rgba(17, 24, 39, 0.5) 0%,    /* gray-900 with 50% opacity */
            rgba(30, 58, 138, 0.4) 50%,  /* blue-900 with 40% opacity */
            rgba(88, 28, 135, 0.3) 100%  /* purple-900 with 30% opacity */
        );
    }
</style>
<div class="animate__animated animate__fadeIn home-gradient-overlay min-h-screen">
    <!-- Hero Section -->
    <div class="text-center py-8 sm:py-16 px-4" style="background: rgba(20, 20, 20, 0.3); border-top: 1px solid rgba(37, 99, 235, 0.2); border-bottom: 1px solid rgba(37, 99, 235, 0.2);">
        <div class="flex justify-center mb-6 sm:mb-8">
            <div class="bg-gradient-to-br from-blue-600 to-blue-500 p-4 sm:p-6 rounded-2xl icon-security shadow-2xl">
                <svg class="h-16 w-16 sm:h-24 sm:w-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold sm:tracking-tight mb-4 sm:mb-6 px-2" style="color: #f1f5f9;">
            Anonymous Encrypted Messaging
        </h1>
        <p class="mt-4 sm:mt-5 max-w-3xl mx-auto text-base sm:text-xl font-medium leading-relaxed px-2" style="color: #cbd5e1;">
            Secure 1-on-1 messaging without email or phone. Create an anonymous account, chat with end-to-end encryption, and messages auto-delete after 24 hours.
        </p>
        <div class="mt-4 sm:mt-6 flex flex-wrap justify-center items-center gap-2 sm:gap-4 px-2">
            <span class="trust-badge text-xs sm:text-sm">Anonymous Accounts</span>
            <span class="trust-badge text-xs sm:text-sm">Zero-Knowledge</span>
            <span class="trust-badge text-xs sm:text-sm">24h Auto-Delete</span>
            <span class="trust-badge text-xs sm:text-sm">1-on-1 Chat</span>
        </div>
    </div>

    <!-- Features Grid -->
    <div class="py-8 sm:py-16 grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3 px-4 sm:px-6 lg:px-8" style="background: rgba(35, 35, 35, 0.4); border-top: 1px solid rgba(37, 99, 235, 0.2); border-bottom: 1px solid rgba(37, 99, 235, 0.2);">
        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">End-to-End Encryption</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Messages are encrypted using AES-256-GCM encryption before leaving your device. Only the recipient with the correct decryption key can read your message.</p>
                </div>
            </div>
        </div>

        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">Anonymous Accounts</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">No email, phone, or personal info required. Create accounts with a unique ID and 24-word recovery phrase. Your identity remains completely private.</p>
                </div>
            </div>
        </div>

        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">Zero-Knowledge Architecture</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Your encryption keys never leave your device, and we cannot decrypt your messages. No IP tracking, no user-agent logging, no metadata collection.</p>
                </div>
            </div>
        </div>

        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">1-on-1 Secure Chat</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Private conversations with contacts. Messages auto-delete after 24 hours. Read receipts show delivery status with colored checkmarks.</p>
                </div>
            </div>
        </div>

        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">Contact Management</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Save contacts by their anonymous ID and assign nicknames. Easily manage your conversation threads and see unread message counts.</p>
                </div>
            </div>
        </div>

        <div class="feature-security p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0 bg-gradient-to-br from-blue-600 to-blue-500 p-3 rounded-lg icon-security">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="ml-5 flex-1">
                    <h3 class="text-xl font-bold mb-2" style="color: #60a5fa;">24-Hour Auto-Delete</h3>
                    <p class="text-sm leading-relaxed" style="color: #e2e8f0;">All messages automatically expire after 24 hours. No manual cleanup needed - your conversation history stays minimal and secure.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="py-12 sm:py-20 px-4" style="background: rgba(20, 20, 20, 0.3); border-top: 1px solid rgba(37, 99, 235, 0.2); border-bottom: 1px solid rgba(37, 99, 235, 0.2);">
        <div class="text-center mb-8 sm:mb-12">
            <h2 class="text-2xl sm:text-4xl font-bold mb-3 sm:mb-4" style="color: #f1f5f9;">How It Works</h2>
            <p class="max-w-2xl mx-auto text-base sm:text-lg px-2" style="color: #cbd5e1;">Simple, secure, and private in three easy steps</p>
        </div>
        
        <div class="grid gap-6 sm:gap-8 md:grid-cols-3 max-w-5xl mx-auto">
            <div class="security-card p-8 text-center">
                <div class="bg-gradient-to-br from-blue-600 to-blue-500 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 icon-security">
                    <span class="text-2xl font-bold text-white">1</span>
                </div>
                <h3 class="text-xl font-bold mb-3" style="color: #60a5fa;">Create Anonymous Account</h3>
                <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Generate a unique anonymous ID and 24-word recovery phrase. No email or phone required. Your keys are created locally and never leave your device.</p>
            </div>
            
            <div class="security-card p-8 text-center">
                <div class="bg-gradient-to-br from-blue-600 to-blue-500 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 icon-security">
                    <span class="text-2xl font-bold text-white">2</span>
                </div>
                <h3 class="text-xl font-bold mb-3" style="color: #60a5fa;">Start Chatting</h3>
                <p class="text-sm leading-relaxed" style="color: #e2e8f0;">Exchange anonymous IDs with contacts and start encrypted conversations. Messages are encrypted with RSA-4096 and AES-256 before sending.</p>
            </div>
            
            <div class="security-card p-8 text-center">
                <div class="bg-gradient-to-br from-blue-600 to-blue-500 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 icon-security">
                    <span class="text-2xl font-bold text-white">3</span>
                </div>
                <h3 class="text-xl font-bold mb-3" style="color: #60a5fa;">Auto-Delete After 24h</h3>
                <p class="text-sm leading-relaxed" style="color: #e2e8f0;">All messages automatically expire after 24 hours. No traces left behind. Read receipts show when messages are delivered and read.</p>
            </div>
        </div>
    </div>

    <!-- Use Cases Section -->
    <div class="py-12 sm:py-20 px-4" style="background: rgba(35, 35, 35, 0.4); border-top: 1px solid rgba(37, 99, 235, 0.2); border-bottom: 1px solid rgba(37, 99, 235, 0.2);">
        <div class="text-center mb-8 sm:mb-12">
            <h2 class="text-2xl sm:text-4xl font-bold mb-3 sm:mb-4" style="color: #f1f5f9;">Who Uses DropCrypt</h2>
            <p class="max-w-2xl mx-auto text-base sm:text-lg px-2" style="color: #cbd5e1;">Trusted by privacy-conscious individuals and professionals</p>
        </div>
        
        <div class="grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
            <div class="feature-security p-5 text-center">
                <svg class="h-10 w-10 mx-auto mb-3" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
                </svg>
                <h4 class="font-semibold mb-2" style="color: #cbd5e1;">Whistleblowers</h4>
                <p class="text-xs" style="color: #94a3b8;">Secure anonymous communication</p>
            </div>
            
            <div class="feature-security p-5 text-center">
                <svg class="h-10 w-10 mx-auto mb-3" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <h4 class="font-semibold mb-2" style="color: #cbd5e1;">Journalists</h4>
                <p class="text-xs" style="color: #94a3b8;">Protect source identity</p>
            </div>
            
            <div class="feature-security p-5 text-center">
                <svg class="h-10 w-10 mx-auto mb-3" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <h4 class="font-semibold mb-2" style="color: #cbd5e1;">Business</h4>
                <p class="text-xs" style="color: #94a3b8;">Confidential negotiations</p>
            </div>
            
            <div class="feature-security p-5 text-center">
                <svg class="h-10 w-10 mx-auto mb-3" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <h4 class="font-semibold mb-2" style="color: #cbd5e1;">Privacy-Conscious</h4>
                <p class="text-xs" style="color: #94a3b8;">Anyone valuing privacy</p>
            </div>
        </div>
    </div>

    <!-- CTA Section - Anonymous Messaging -->
    <div class="py-12 sm:py-20 text-center px-4" style="background: rgba(20, 20, 20, 0.3); border-top: 1px solid rgba(37, 99, 235, 0.2);">
        <div class="security-card p-6 sm:p-12 max-w-4xl mx-auto">
            <h2 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4" style="color: #f1f5f9;">Get Started with DropCrypt</h2>
            <p class="text-base sm:text-lg mb-6 sm:mb-8" style="color: #cbd5e1;">
                Create your anonymous account in seconds. No email, no phone number, no tracking. 
                Start encrypted conversations that auto-delete after 24 hours.
            </p>
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
                <a href="/account/create" class="btn-security inline-flex items-center px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-lg font-semibold focus:outline-none w-full sm:w-auto justify-center">
                    <svg class="mr-2 sm:mr-3 h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                    </svg>
                    Create Anonymous Account
                </a>
                
                <a href="/account/login" class="inline-flex items-center px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-lg font-semibold focus:outline-none w-full sm:w-auto justify-center bg-gray-800 hover:bg-gray-700 text-white rounded-lg transition-all duration-200 border border-gray-600">
                    <svg class="mr-2 sm:mr-3 h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                    </svg>
                    Login to Existing Account
                </a>
            </div>

            <!-- Features -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm" style="color: #94a3b8;">
                <div class="flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    No Email Required
                </div>
                <div class="flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    RSA-4096 + AES-256
                </div>
                <div class="flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    24h Message Expiry
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 