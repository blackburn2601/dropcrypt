# Application
APP_ENV=dev
APP_SECRET=generate_with_openssl_rand_hex_32
APP_DEBUG=1

# Database
DB_USER=dropcrypt
DB_PASSWORD=dropcrypt
DB_NAME=dropcrypt
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@mysql:3306/${DB_NAME}?serverVersion=8.0

# CORS Configuration
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Message Configuration
MESSAGE_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
MESSAGE_DEFAULT_EXPIRY=24
MESSAGE_MAX_LENGTH=10000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
