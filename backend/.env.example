# Copy to backend/.env (setup.sh does this and fills in the two secrets below).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=

# Database
DB_USER=dropcrypt
DB_PASSWORD=dropcrypt
DB_NAME=dropcrypt
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?serverVersion=15&charset=utf8"

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Message settings
MESSAGE_ENCRYPTION_KEY=
MESSAGE_DEFAULT_EXPIRY=24
MESSAGE_MAX_LENGTH=10000
